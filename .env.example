# ============================================================
# Praise Helper - 환경 변수 설정 예시
# 실제 환경 변수는 .env 파일에 작성하며, .env 파일은 Git에 업로드되지 않습니다.
# ============================================================

# Tailscale Funnel / Bridge Server Base URL (OpenAI 호환 규격)
VITE_BRIDGE_BASE_URL=https://your-bridge-server.ts.net/v1

# Authorization Bearer Token (브릿지 서버 내부 자동 주입 시 dummy-key 권장)
VITE_BRIDGE_API_KEY=dummy-key

# 사용할 모델명 (예: gemini-3.1-pro, gemini-2.5-flash 등)
VITE_BRIDGE_MODEL=gemini-3.1-pro
